  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^6.0.3",
    "vite-plus": "^1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "preact": "^11.1.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
